NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bubt_nexus
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional: leave blank to just log verification emails to the server console (dev mode).
# Fill these in with real SMTP credentials (e.g. Gmail app password, Mailtrap, SendGrid SMTP) to send real emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="BUBT Nexus <no-reply@bubtnexus.edu>"

# Google Sign-In: create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials and add your frontend
# origin (e.g. http://localhost:5173) under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=1005223177664-8rccrrda8r8sdrvat926fof1f1bk0f8g.apps.googleusercontent.com

# Used only by `npm run create-admin` to create/promote the first admin account.
# Not read anywhere else - safe to remove from .env after you've run the script once.
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@bubtnexus.edu
ADMIN_PASSWORD=change_this_to_a_strong_password
